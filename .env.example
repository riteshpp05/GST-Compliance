# ==============================================================================
# UC15 GST Compliance Intelligence & Resolution Agent - Environment Configuration
# ==============================================================================

# Application Environment (development, testing, production)
APP_ENV=development

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Data Ingestion Paths
DATA_PATH=data/UC15_GSTCompliance_Dataset.xlsx
RESULTS_DIR=results

# LLM Configuration (Optional summary narrative)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_API_KEY=

# Server / API Port
API_PORT=8000
API_HOST=0.0.0.0

# Business Rule Thresholds
EWAY_BILL_THRESHOLD_INR=50000
RATE_TOLERANCE_PCT=0.01

# Operational SLAs (Hours)
NEEDS_REVIEW_SLA_HOURS=24
NON_COMPLIANT_SLA_HOURS=4

# SAP S/4HANA Live OData V4 Integration Configuration
SAP_ODATA_BASE_URL=http://192.168.1.55:8000/sap/opu/odata4/sap/z_gst_sb/srvd_a2x/sap/zui_gst_invoices/0001
SAP_CLIENT=200
SAP_COMPANY_CODE=DI01
SAP_AUTH_TYPE=basic
SAP_USERNAME=YOUR_TECHNICAL_USER
SAP_PASSWORD=YOUR_PASSWORD
SAP_OAUTH_TOKEN_URL=
SAP_OAUTH_CLIENT_ID=
SAP_OAUTH_CLIENT_SECRET=
SAP_OUTWARD_SERVICE=
SAP_OUTWARD_ENTITY=OutwardInvoice
SAP_INWARD_SERVICE=
SAP_INWARD_ENTITY=InwardInvoice

